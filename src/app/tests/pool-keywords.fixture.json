  {
    "section": "pool",
    "option": "network",
    "types": [
      "drbd"
    ],
    "text": "The name of the backend network to use for the drbd traffic of the volumes\nthe pool creates, set as the `network` keyword of their `disk.drbd`\nresource. Set this keyword if some node names are resolved to NATed\naddresses.\n\nThe address of a node is then the first of the segment the network assigned\nit, so the network is a `routed_bridge`: a network giving the nodes no\nsegment of their own, as a `lan`, is refused. Name the addresses with\n`addr@<node>` there.\n",
    "default": "",
    "defaultText": "",
    "example": "backend1",
    "candidates": [],
    "converter": "",
    "required": false,
    "scopable": false
